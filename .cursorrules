4. الـ Options System (نظام الإعدادات)
=============================================================

كل option يتخزن في wp_options باسم:
'ccs_option_{module}_{feature}'
مثال: 'ccs_option_bot_allow_googlebot' = true/false

الـ Default values:
  Bot Protection:
    ccs_bot_allow_googlebot          = true   ← دايماً true افتراضي
    ccs_bot_allow_google_merchant    = true   ← دايماً true افتراضي
    ccs_bot_verify_reverse_dns       = true
    ccs_bot_block_scrapers           = true
    ccs_bot_honeypot                 = false
    ccs_bot_geidea_whitelist         = true   ← دايماً true افتراضي

  Server Rules:
    ccs_server_fail2ban              = true
    ccs_server_rate_limiting         = true
    ccs_server_geoip_block           = false  ← false افتراضي
    ccs_server_export_htaccess       = false
    ccs_server_antiddos              = true

  Login Security:
    ccs_login_brute_force            = true
    ccs_login_change_url             = false  ← false افتراضي (يحتاج تعديل يدوي)
    ccs_login_2fa_admin              = true
    ccs_login_2fa_customer           = false
    ccs_login_ip_whitelist           = true

  Firewall:
    ccs_firewall_sql_injection       = true
    ccs_firewall_xss                 = true
    ccs_firewall_file_upload         = true
    ccs_firewall_headers             = true
    ccs_firewall_dokan_exclusion     = true   ← دايماً true

  Database & Files:
    ccs_db_table_prefix              = false  ← يحتاج تأكيد يدوي
    ccs_db_file_monitor              = true
    ccs_db_disable_file_edit         = true
    ccs_db_activity_monitor          = true

  Audit Log:
    ccs_log_admin_events             = true
    ccs_log_email_alerts             = true
    ccs_log_weekly_report            = false

